+    def blend_tracks(self, s, blend, nframe, fps, loop):
+        """一条序列某一 blend 的逐骨骼轨道（一个 blend = 原有口径的一整套姿势）。
+
+        通道头按 `[blend][bone]` 排 ⇒ 本 blend 里第 src 根骨的头在 `animindex + (blend*numbones + src)*12`。
+        """
+        m = self.m
+        tracks = []
+        for src in self.keep:
+            base = s.animindex + (blend * len(self.bones) + src) * 12
+            # 逐帧数据 = 六个通道里至少一个通道"这一段覆盖不满整条序列"：
+            # 块头 = (值个数, 本段覆盖帧数)。整段一个值（值个数 1 **且**覆盖满 nframe 帧）
+            # ⇒ 常量，只写首末两帧；只要有一段覆盖不满 ⇒ 后面还有别的段 ⇒ 这一根骨是动的。
+            # ⚠️ 只看"值个数 > 1"会漏掉"值个数 1 但只覆盖前半段"的那种（v_usp 的 bone42 在
+            # reload 里是 (1, 91) / draw 里 (1, 26)）—— 漏掉会让弹匣/滑套在换弹里不动。
+            has = False
+            for j in range(6):
+                o = struct.unpack_from("<h", m.b, base + j * 2)[0]
+                if o == 0:
+                    continue
+                head = m.b[base + o]
+                span = m.b[base + o + 1]
+                if head > 1 or span != nframe:
+                    has = True
+                    break
+            frames = range(nframe + 1) if has else (0, nframe)
+            tr = []
+            for k in frames:
+                pos, ang = m.sample(s, src, k, blend)
+                p = list(pos)
+                if self.bones[src].parent < 0:
+                    p = [p[j] - self.lo[j] for j in range(3)]
+                R = perm_mat(cs16_mdl.quat_mat(cs16_mdl.angle_quat(*ang)))
+                tr.append((k / fps, [c * self.scale for c in perm3(p)], mat_quat(R)))
+            if len(tr) > 1:
+                # 通道数据只覆盖到第 nframes-1 帧：循环序列末帧回绕成首帧，非循环序列末帧保持上一帧
+                src_k = 0 if loop else len(tr) - 2
+                tr[-1] = (tr[-1][0], list(tr[src_k][1]), tr[src_k][2])
+            tracks.append(tr)
+        return tracks
