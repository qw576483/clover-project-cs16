<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cs16anim-blend-readcheck</AssemblyName>
    <RootNamespace>Cs16AnimBlendReadcheck</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0169;CS0649</NoWarn>
    <!-- Repo root, derived from this file's own location (tools/probes/hosts/blendread -> up 4).
         Override if the probe is copied elsewhere:  -p:ProjectRoot=C:\path\to\repo -->
    <ProjectRoot Condition="'$(ProjectRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</ProjectRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The real editor-side reader, compiled into this assembly so its internal types are
         reachable.  It is deliberately free of UnityEngine, which is why this runs offline. -->
    <Compile Include="$(ProjectRoot)\client\Assets\Editor\Views\Cs16AnimData.cs" />
  </ItemGroup>

</Project>
