<Project Sdk="Microsoft.NET.Sdk">

  <!-- 引擎 `CloverEngine.Data` 程序集（映射 Runtime/Data/CloverEngine.Data.asmdef；references: Core） -->

  <PropertyGroup>
    <AssemblyName>CloverEngine.Data</AssemblyName>
    <RootNamespace>CloverEngine</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(EngineRoot)Runtime\Data\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\CloverEngine.Core.csproj" />
  </ItemGroup>

</Project>
