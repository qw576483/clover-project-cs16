<Project Sdk="Microsoft.NET.Sdk">

  <!-- 引擎 `CloverEngine.Presentation` 程序集（映射 Runtime/Presentation/CloverEngine.Presentation.asmdef；references: Core） -->

  <PropertyGroup>
    <AssemblyName>CloverEngine.Presentation</AssemblyName>
    <RootNamespace>CloverEngine</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(EngineRoot)Runtime\Presentation\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\CloverEngine.Core.csproj" />
  </ItemGroup>

</Project>
