<Project Sdk="Microsoft.NET.Sdk">

  <!-- 引擎 `CloverEngine.Editor` 程序集（映射 clover-client-unity-engine/Editor/CloverEngine.Editor.asmdef；
       references: Core + Data + Network + Resource + Presentation；includePlatforms: Editor）。

       ⚠️ AssemblyName 必须是 `CloverEngine.Editor`：Network / Presentation / Resource 的
       `Runtime/*/AssemblyInfo.cs` 里写着 `InternalsVisibleTo("CloverEngine.Editor")`，
       `Editor/MapBake/MapBaker.cs` 用的就是运行时域 internal 的 `CloverMapMarker`。
       程序集名不对 = 契约不成立 = 凭空 CS0122（实测：改名后立刻 2 条 CS0122）。 -->

  <PropertyGroup>
    <AssemblyName>CloverEngine.Editor</AssemblyName>
    <RootNamespace>CloverEngine.Editor</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(EngineRoot)Editor\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\CloverEngine.Core.csproj" />
    <ProjectReference Include="..\Data\CloverEngine.Data.csproj" />
    <ProjectReference Include="..\Network\CloverEngine.Network.csproj" />
    <ProjectReference Include="..\Resource\CloverEngine.Resource.csproj" />
    <ProjectReference Include="..\Presentation\CloverEngine.Presentation.csproj" />
  </ItemGroup>

</Project>
